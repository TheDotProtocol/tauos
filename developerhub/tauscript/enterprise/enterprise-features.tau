    export class QueueManager {
        private queues: Map<string, any[]>;
        
        constructor() {
            this.queues = new Map();
        }
        
        enqueue(queue: string, message: any): void {
            if (!this.queues.has(queue)) {
                this.queues.set(queue, []);
            }
            this.queues.get(queue)!.push(message);
        }
        
        dequeue(queue: string): any {
            const queue = this.queues.get(queue);
            if (!queue || queue.length === 0) return null;
            return queue.shift();
        }
        
        getSize(queue: string): number {
            const queue = this.queues.get(queue);
            return queue ? queue.length : 0;
        }
    }
    
    // Types
    export interface Session {
        id: string;
        userId: string;
        ip: string;
        createdAt: Date;
        expiresAt: Date;
        isActive: boolean;
    }
    
