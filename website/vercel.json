{
  "version": 2,
  "builds": [
    {
      "src": "website/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "website/taumail-v2-backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/v2/(.*)",
      "dest": "/website/taumail-v2-backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "website/$1"
    }
  ]
}