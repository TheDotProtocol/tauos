// TauScript Standard Library - I/O Module
// File system and input/output operations that make TauScript powerful!

module IO {
    // File Operations
    export func readFile(path: string): Promise<string> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.readFile(path, 'utf8', (err: any, data: string) => {
                if (err) {
                    reject(err);
                } else {
                    resolve(data);
                }
            });
        });
    }
    
    export func writeFile(path: string, content: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.writeFile(path, content, 'utf8', (err: any) => {
                if (err) {
                    reject(err);
                } else {
                    resolve();
                }
            });
        });
    }
    
    export func appendFile(path: string, content: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.appendFile(path, content, 'utf8', (err: any) => {
                if (err) {
                    reject(err);
                } else {
                    resolve();
                }
            });
        });
    }
    
    export func deleteFile(path: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.unlink(path, (err: any) => {
                if (err) {
                    reject(err);
                } else {
                    resolve();
                }
            });
        });
    }
    
    export func fileExists(path: string): Promise<boolean> {
        return new Promise((resolve) => {
            const fs = require('fs');
            fs.access(path, (err: any) => {
                resolve(!err);
            });
        });
    }
    
    export func getFileStats(path: string): Promise<object> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.stat(path, (err: any, stats: any) => {
                if (err) {
                    reject(err);
                } else {
                    resolve({
                        size: stats.size,
                        isFile: stats.isFile(),
                        isDirectory: stats.isDirectory(),
                        createdAt: stats.birthtime,
                        modifiedAt: stats.mtime,
                        accessedAt: stats.atime
                    });
                }
            });
        });
    }
    
    // Directory Operations
    export func createDirectory(path: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.mkdir(path, { recursive: true }, (err: any) => {
                if (err) {
                    reject(err);
                } else {
                    resolve();
                }
            });
        });
    }
    
    export func deleteDirectory(path: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.rmdir(path, { recursive: true }, (err: any) => {
                if (err) {
                    reject(err);
                } else {
                    resolve();
                }
            });
        });
    }
    
    export func listDirectory(path: string): Promise<string[]> {
        return new Promise((resolve, reject) => {
            const fs = require('fs');
            fs.readdir(path, (err: any, files: string[]) => {
                if (err) {
                    reject(err);
                } else {
                    resolve(files);
                }
            });
        });
    }
    
    export func directoryExists(path: string): Promise<boolean> {
        return new Promise((resolve) => {
            const fs = require('fs');
            fs.access(path, (err: any) => {
                resolve(!err);
            });
        });
    }
    
    // Path Operations
    export func joinPath(...paths: string[]): string {
        const path = require('path');
        return path.join(...paths);
    }
    
    export func resolvePath(path: string): string {
        const path = require('path');
        return path.resolve(path);
    }
    
    export func getDirectoryName(path: string): string {
        const path = require('path');
        return path.dirname(path);
    }
    
    export func getFileName(path: string): string {
        const path = require('path');
        return path.basename(path);
    }
    
    export func getFileExtension(path: string): string {
        const path = require('path');
        return path.extname(path);
    }
    
    export func getFileNameWithoutExtension(path: string): string {
        const path = require('path');
        return path.basename(path, path.extname(path));
    }
    
    // Stream Operations
    export func createReadStream(path: string): any {
        const fs = require('fs');
        return fs.createReadStream(path);
    }
    
    export func createWriteStream(path: string): any {
        const fs = require('fs');
        return fs.createWriteStream(path);
    }
    
    export func pipeStreams(source: any, destination: any): Promise<void> {
        return new Promise((resolve, reject) => {
            source.pipe(destination);
            destination.on('finish', resolve);
            destination.on('error', reject);
        });
    }
    
    // JSON Operations
    export func readJSON(path: string): Promise<any> {
        return readFile(path).then(content => JSON.parse(content));
    }
    
    export func writeJSON(path: string, data: any): Promise<void> {
        return writeFile(path, JSON.stringify(data, null, 2));
    }
    
    export func appendJSON(path: string, data: any): Promise<void> {
        return readJSON(path).then(existing => {
            const combined = Array.isArray(existing) ? [...existing, data] : { ...existing, ...data };
            return writeJSON(path, combined);
        }).catch(() => {
            return writeJSON(path, data);
        });
    }
    
    // CSV Operations
    export func readCSV(path: string, delimiter: string = ','): Promise<string[][]> {
        return readFile(path).then(content => {
            const lines = content.split('\n');
            return lines.map(line => line.split(delimiter));
        });
    }
    
    export func writeCSV(path: string, data: string[][], delimiter: string = ','): Promise<void> {
        const content = data.map(row => row.join(delimiter)).join('\n');
        return writeFile(path, content);
    }
    
    // Logging
    export func log(message: string, level: string = 'info'): void {
        const timestamp = new Date().toISOString();
        const logMessage = `[${timestamp}] [${level.toUpperCase()}] ${message}`;
        console.log(logMessage);
    }
    
    export func logError(message: string): void {
        log(message, 'error');
    }
    
    export func logWarning(message: string): void {
        log(message, 'warning');
    }
    
    export func logInfo(message: string): void {
        log(message, 'info');
    }
    
    export func logDebug(message: string): void {
        log(message, 'debug');
    }
    
    // Input Operations
    export func readLine(): Promise<string> {
        return new Promise((resolve) => {
            const readline = require('readline');
            const rl = readline.createInterface({
                input: process.stdin,
                output: process.stdout
            });
            
            rl.question('', (answer: string) => {
                rl.close();
                resolve(answer);
            });
        });
    }
    
    export func readPassword(prompt: string = 'Password: '): Promise<string> {
        return new Promise((resolve) => {
            const readline = require('readline');
            const rl = readline.createInterface({
                input: process.stdin,
                output: process.stdout
            });
            
            rl.question(prompt, (answer: string) => {
                rl.close();
                resolve(answer);
            });
        });
    }
    
    export func confirm(message: string): Promise<boolean> {
        return new Promise((resolve) => {
            const readline = require('readline');
            const rl = readline.createInterface({
                input: process.stdin,
                output: process.stdout
            });
            
            rl.question(`${message} (y/n): `, (answer: string) => {
                rl.close();
                resolve(answer.toLowerCase() === 'y' || answer.toLowerCase() === 'yes');
            });
        });
    }
}
