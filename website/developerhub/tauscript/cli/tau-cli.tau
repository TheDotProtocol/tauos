    export class HelpCommand extends Command {
        constructor() {
            super('help', 'Show help information', '[command]');
        }
        
        async execute(args: string[]): Promise<void> {
            if (args.length > 0) {
                // Show help for specific command
                console.log(`📖 Help for command: ${args[0]}`);
            } else {
                // Show general help
                console.log('📖 TauScript CLI Help');
                console.log('');
                console.log('Usage: tau <command> [options]');
                console.log('');
                console.log('Commands:');
                console.log('  init        Initialize a new TauScript project');
                console.log('  run         Run a TauScript file or project');
                console.log('  build       Build a TauScript project');
                console.log('  test        Run tests for a TauScript project');
                console.log('  lint        Lint TauScript code');
                console.log('  format      Format TauScript code');
                console.log('  install     Install TauScript packages');
                console.log('  update      Update TauScript packages');
                console.log('  remove      Remove TauScript packages');
                console.log('  list        List installed TauScript packages');
                console.log('  search      Search TauScript packages');
                console.log('  outdated    Check for outdated TauScript packages');
                console.log('  audit       Audit TauScript packages for security vulnerabilities');
                console.log('  version     Show TauScript version information');
                console.log('  help        Show help information');
            }
        }
    }
    
    // Option Class
    export class Option {
        public name: string;
        public short?: string;
        public description: string;
        public type: string;
        public required: boolean;
        public defaultValue: any;
        
        constructor(name: string, short?: string, description: string = '', type: string = 'string', required: boolean = false, defaultValue: any = undefined) {
            this.name = name;
            this.short = short;
            this.description = description;
            this.type = type;
            this.required = required;
            this.defaultValue = defaultValue;
        }
    }
}
