                    engines: { "tau": ">=1.0.0" },
                    dependencies: {},
                    devDependencies: {}
                },
                {
                    name: "tau-web",
                    version: "1.0.0",
                    description: "Web framework for building modern web applications",
                    author: "TauScript Team",
