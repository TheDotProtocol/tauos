                    keywords: ["web", "framework", "http", "server"],
                    tags: ["web", "framework", "http", "server"],
                    category: "Web",
                    featured: true,
                    createdAt: new Date(),
                    updatedAt: new Date(),
                    repository: "https://github.com/tauscript/tau-web",
                    homepage: "https://tau-web.tauscript.com",
                    bugs: "https://github.com/tauscript/tau-web/issues",
                    engines: { "tau": ">=1.0.0" },
