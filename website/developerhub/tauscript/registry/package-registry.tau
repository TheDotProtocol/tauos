// TauScript Package Registry - The Ultimate Package Management System
// Making TauScript the most package-friendly language with the best registry!

module TauRegistry {
    // Package Registry
    export class PackageRegistry {
        private packages: Map<string, Package>;
        private categories: Map<string, string[]>;
        private tags: Map<string, string[]>;
        private downloads: Map<string, number>;
        private ratings: Map<string, number>;
        private reviews: Map<string, Review[]>;
        
        constructor() {
            this.packages = new Map();
            this.categories = new Map();
            this.tags = new Map();
            this.downloads = new Map();
            this.ratings = new Map();
            this.reviews = new Map();
            this.initializeRegistry();
        }
        
        // Package Management
        async publishPackage(packageData: Package): Promise<void> {
            console.log(`📦 Publishing package: ${packageData.name}@${packageData.version}`);
            
            // Validate package
            this.validatePackage(packageData);
            
            // Check for conflicts
            if (this.packages.has(packageData.name)) {
                const existing = this.packages.get(packageData.name)!;
                if (existing.version === packageData.version) {
                    throw new Error(`Package ${packageData.name}@${packageData.version} already exists`);
                }
            }
            
            // Store package
            this.packages.set(packageData.name, packageData);
            
            // Update categories
            this.updateCategories(packageData);
            
            // Update tags
            this.updateTags(packageData);
            
            // Initialize metrics
            this.downloads.set(packageData.name, 0);
            this.ratings.set(packageData.name, 0);
            this.reviews.set(packageData.name, []);
            
            console.log(`✅ Package ${packageData.name}@${packageData.version} published successfully!`);
        }
        
        async getPackage(name: string, version?: string): Promise<Package | null> {
            const packageData = this.packages.get(name);
            if (!packageData) return null;
            
            if (version) {
                if (packageData.version !== version) {
                    return null;
                }
            }
            
            return packageData;
        }
        
        async searchPackages(query: string, filters?: SearchFilters): Promise<Package[]> {
            console.log(`🔍 Searching packages: ${query}`);
            
            let results = Array.from(this.packages.values());
            
            // Filter by query
            if (query) {
                results = results.filter(pkg => 
                    pkg.name.toLowerCase().includes(query.toLowerCase()) ||
                    pkg.description.toLowerCase().includes(query.toLowerCase()) ||
                    pkg.keywords.some(keyword => keyword.toLowerCase().includes(query.toLowerCase()))
                );
            }
            
            // Apply filters
            if (filters) {
                if (filters.category) {
                    results = results.filter(pkg => pkg.category === filters.category);
                }
                
                if (filters.tags && filters.tags.length > 0) {
                    results = results.filter(pkg => 
                        filters.tags!.some(tag => pkg.tags.includes(tag))
                    );
                }
                
                if (filters.minRating) {
                    results = results.filter(pkg => 
                        (this.ratings.get(pkg.name) || 0) >= filters.minRating!
                    );
                }
                
                if (filters.minDownloads) {
                    results = results.filter(pkg => 
                        (this.downloads.get(pkg.name) || 0) >= filters.minDownloads!
                    );
                }
            }
            
            // Sort results
            results.sort((a, b) => {
                const aDownloads = this.downloads.get(a.name) || 0;
                const bDownloads = this.downloads.get(b.name) || 0;
                return bDownloads - aDownloads;
            });
            
            return results;
        }
        
        async getPopularPackages(limit: number = 10): Promise<Package[]> {
            const packages = Array.from(this.packages.values());
            
            return packages
                .sort((a, b) => {
                    const aDownloads = this.downloads.get(a.name) || 0;
                    const bDownloads = this.downloads.get(b.name) || 0;
                    return bDownloads - aDownloads;
                })
                .slice(0, limit);
        }
        
        async getFeaturedPackages(): Promise<Package[]> {
            const packages = Array.from(this.packages.values());
            
            return packages
                .filter(pkg => pkg.featured)
                .sort((a, b) => {
                    const aRating = this.ratings.get(a.name) || 0;
                    const bRating = this.ratings.get(b.name) || 0;
                    return bRating - aRating;
                });
        }
        
        async getCategories(): Promise<string[]> {
            return Array.from(this.categories.keys());
        }
        
        async getTags(): Promise<string[]> {
            return Array.from(this.tags.keys());
        }
        
        // Download Management
        async downloadPackage(name: string, version?: string): Promise<Package> {
            const packageData = await this.getPackage(name, version);
            if (!packageData) {
                throw new Error(`Package ${name} not found`);
            }
            
            // Increment download count
            const currentDownloads = this.downloads.get(name) || 0;
            this.downloads.set(name, currentDownloads + 1);
            
            console.log(`📥 Package ${name}@${packageData.version} downloaded`);
            return packageData;
        }
        
        async getDownloadCount(name: string): Promise<number> {
            return this.downloads.get(name) || 0;
        }
        
        // Rating and Review Management
        async ratePackage(name: string, rating: number, userId: string): Promise<void> {
            if (rating < 1 || rating > 5) {
                throw new Error("Rating must be between 1 and 5");
            }
            
            const packageData = this.packages.get(name);
            if (!packageData) {
                throw new Error(`Package ${name} not found`);
            }
            
            // Update rating
            const currentRating = this.ratings.get(name) || 0;
            const newRating = (currentRating + rating) / 2;
            this.ratings.set(name, newRating);
            
            console.log(`⭐ Package ${name} rated ${rating}/5 by user ${userId}`);
        }
        
        async reviewPackage(name: string, review: Review): Promise<void> {
            const packageData = this.packages.get(name);
            if (!packageData) {
                throw new Error(`Package ${name} not found`);
            }
            
            const reviews = this.reviews.get(name) || [];
            reviews.push(review);
            this.reviews.set(name, reviews);
            
            console.log(`📝 Review added for package ${name} by user ${review.userId}`);
        }
        
        async getPackageReviews(name: string): Promise<Review[]> {
            return this.reviews.get(name) || [];
        }
        
        async getPackageRating(name: string): Promise<number> {
            return this.ratings.get(name) || 0;
        }
        
        // Analytics
        async getPackageAnalytics(name: string): Promise<PackageAnalytics> {
            const packageData = this.packages.get(name);
            if (!packageData) {
                throw new Error(`Package ${name} not found`);
            }
            
            return {
                name: name,
                downloads: this.downloads.get(name) || 0,
                rating: this.ratings.get(name) || 0,
                reviewCount: (this.reviews.get(name) || []).length,
                lastUpdated: packageData.updatedAt,
                createdAt: packageData.createdAt
            };
        }
        
        async getRegistryStats(): Promise<RegistryStats> {
            const totalPackages = this.packages.size;
            const totalDownloads = Array.from(this.downloads.values()).reduce((sum, count) => sum + count, 0);
            const averageRating = Array.from(this.ratings.values()).reduce((sum, rating) => sum + rating, 0) / this.ratings.size;
            
            return {
                totalPackages,
                totalDownloads,
                averageRating,
                categories: this.categories.size,
                tags: this.tags.size,
                lastUpdated: new Date()
            };
        }
        
        // Private methods
        private validatePackage(packageData: Package): void {
            if (!packageData.name) {
                throw new Error("Package name is required");
            }
            
            if (!packageData.version) {
                throw new Error("Package version is required");
            }
            
            if (!packageData.description) {
                throw new Error("Package description is required");
            }
            
            if (!packageData.author) {
                throw new Error("Package author is required");
            }
            
            if (!packageData.license) {
                throw new Error("Package license is required");
            }
        }
        
        private updateCategories(packageData: Package): void {
            if (packageData.category) {
                const categoryPackages = this.categories.get(packageData.category) || [];
                if (!categoryPackages.includes(packageData.name)) {
                    categoryPackages.push(packageData.name);
                    this.categories.set(packageData.category, categoryPackages);
                }
            }
        }
        
        private updateTags(packageData: Package): void {
            for (const tag of packageData.tags) {
                const tagPackages = this.tags.get(tag) || [];
                if (!tagPackages.includes(packageData.name)) {
                    tagPackages.push(packageData.name);
                    this.tags.set(tag, tagPackages);
                }
            }
        }
        
        private initializeRegistry(): void {
            // Initialize with some popular packages
            this.initializePopularPackages();
        }
        
