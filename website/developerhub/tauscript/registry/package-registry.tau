                },
                {
                    name: "tau-ai",
                    version: "1.0.0",
                    description: "AI SDK for machine learning and artificial intelligence",
                    author: "TauScript Team",
                    license: "MIT",
                    keywords: ["ai", "ml", "machine-learning", "neural-networks"],
                    tags: ["ai", "ml", "machine-learning", "neural-networks"],
                    category: "AI",
                    featured: true,
                    createdAt: new Date(),
                    updatedAt: new Date(),
                    repository: "https://github.com/tauscript/tau-ai",
                    homepage: "https://tau-ai.tauscript.com",
                    bugs: "https://github.com/tauscript/tau-ai/issues",
                    engines: { "tau": ">=1.0.0" },
