{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "public": true,
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://tauos.vercel.app"
  },
  "functions": {
    "website/src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1", "sfo1", "lhr1", "hnd1"],
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://tauos.org/taumail",
      "has": [
        {
          "type": "host",
          "value": "mail.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://tauos.org/taucloud",
      "has": [
        {
          "type": "host",
          "value": "cloud.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://www.tauos.org/tauid",
      "has": [
        {
          "type": "host",
          "value": "id.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://tauos-store-backend.vercel.app",
      "has": [
        {
          "type": "host",
          "value": "store.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://tauos-nmlq.vercel.app",
      "has": [
        {
          "type": "host",
          "value": "browser.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://tauos-desktop-demo.vercel.app",
      "has": [
        {
          "type": "host",
          "value": "desktop.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://tauos-mobile-demo.vercel.app",
      "has": [
        {
          "type": "host",
          "value": "mobile.tauos.org"
        }
      ],
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/docs/:path*",
      "destination": "/docs/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "*/5 * * * *"
    }
  ]
}
