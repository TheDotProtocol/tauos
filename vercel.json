{
  "redirects": [
    {
      "source": "/",
      "destination": "https://tauos.org/taumail",
      "has": [
        {
          "type": "host",
          "value": "mail.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://tauos.org/taucloud",
      "has": [
        {
          "type": "host",
          "value": "cloud.tauos.org"
        }
      ],
      "permanent": false
    },
    {
      "source": "/(.*)",
      "destination": "https://www.tauos.org/tauid",
      "has": [
        {
          "type": "host",
          "value": "id.tauos.org"
        }
      ],
      "permanent": false,
      "statusCode": 302
    }
  ]
}
