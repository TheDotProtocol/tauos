# TauOS environment template — copy to `.env.local` and fill in values.
# Never commit `.env.local` or real secrets to git.

# Core
DATABASE_URL=postgresql://user:password@localhost:5432/tauos
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SSO / JWT (required — use a long random string in production)
TAU_JWT_SECRET=change-me-to-a-long-random-secret
JWT_SECRET=

# Redis — Upstash REST (recommended for Vercel / serverless)
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Alternative: Redis protocol (Developer Hub legacy client)
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR-INSTANCE.upstash.io:6379

# OAuth — Google (https://console.cloud.google.com/)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Mail
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Supabase storage (Tau Cloud, Mail attachments, etc.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Tau IDE / sandbox (see .env.tau-ide.example)
# Copy .env.tau-ide.example for IDE-specific vars.
