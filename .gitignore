# TauOS Production .gitignore

# Environment variables and secrets
.env
.env.local
.env.production
.env.development
*.env
*secret*
# Allow Tau IDE secrets API route and server module (not secret values)
!src/app/api/tau-ide/projects/**/secrets/
!src/app/api/tau-ide/projects/**/secrets/**
!src/lib/tau-ide/server/secrets.ts
*password*
*key*
# Allow Next.js API route folders (not secret files)
!src/app/api/**/password/
!src/app/api/**/password/**
!src/app/api/**/keys/
!src/app/api/**/keys/**
!src/app/api/developers/api-keys/
!src/app/api/developers/api-keys/**
!src/app/developers/(platform)/api-keys/
!src/app/developers/(platform)/api-keys/**
!src/components/tau-developer/DeveloperApiKeysContent.tsx

# Database files
*.sql
*.db
*.sqlite
.data/tau-ide/

# Test files
*test*.js
*verification*.js
*create*.js
*verify*.js
*check*.js

# Documentation with sensitive info
TAUOS_EMAIL_ACCOUNTS.md
SECURITY_*.md
STATUS.md
RELEASE_*.md
ROLLBACK.md
RUNBOOK.md

# Local development documentation (not shipped to GitHub)
/docs/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
.next/
out/
build/
dist/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Temporary folders
tmp/
temp/kernel-build/linux-6.14.tar.xz
*.tar.xz
.vercel

# Rust / TypeScript build artifacts
target/
*.tsbuildinfo

# Local ISO/build outputs (ISO served via GitHub Releases — see public/downloads/manifest.json)
*.iso
!public/downloads/manifest.json
# Installers — host on GitHub Releases (git push limit 100MB; release assets up to 2GB)
public/downloads/*.exe
public/downloads/*.dmg
public/downloads/*.deb
public/downloads/*.AppImage
public/downloads/*.apk
os-code/installer-scripts/.bin/
os-code/installer-scripts/dist/
os-code/installer-scripts/resources/*.iso
kernel-build/linux-6.14/
release-files/*.iso
release-files/tauos-core-*.tar.gz
public/TauOS-Desktop.iso
tauos-desktop.iso
new-website/sources/emergent/
new-website/sources/replit/

# Bulk mailbox provisioning (contains real addresses/passwords)
scripts/mailboxes.json
scripts/mailboxes-provisioned.json
