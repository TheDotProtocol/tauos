# Deploy only the root Next.js app (~96k tracked files in this monorepo).
# Whitelist approach: Vercel's ignore matcher is unreliable with negation-only rules.
/*
!/package.json
!/package-lock.json
!/next.config.js
!/vercel.json
!/tsconfig.json
!/tailwind.config.ts
!/tailwind.config.js
!/postcss.config.js
!/next-env.d.ts
!/components.json
!/.vercelignore
!/src
!/src/**
!/public
!/public/**
