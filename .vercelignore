# Ignore everything at repo root, then allowlist the Next.js app only.
/*
!/package.json
!/package-lock.json
!/next.config.js
!/vercel.json
!/tsconfig.json
!/tailwind.config.ts
!/tailwind.config.js
!/postcss.config.js
!/next-env.d.ts
!/components.json
!/.vercelignore
!/src
!/src/**/*
!/scripts
!/scripts/**/*
!/public
!/public/**/*
# Large tracked binaries — host via GitHub Releases, not Vercel
/public/downloads/*.iso
/public/downloads/*.dmg
/public/downloads/*.exe
/public/downloads/*.deb
/public/downloads/*.AppImage
/public/tauos-simple-20250730.iso
/public/TauOS-Desktop.iso
/public/**/*.iso
