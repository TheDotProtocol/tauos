[Unit]
Description=TauOS Desktop Session
Documentation=https://www.tauos.org
After=network-online.target dbus.socket seatd.service
Wants=network-online.target seatd.service

[Service]
Type=simple
User=tau
Group=tau
Environment=TAUOS_VERSION=1.0.0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
WorkingDirectory=/home/tau
ExecStartPre=/bin/mkdir -p /run/user/1000
ExecStartPre=/bin/chown tau:tau /run/user/1000
ExecStartPre=/bin/chmod 0700 /run/user/1000
ExecStart=/usr/bin/tau-desktop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
