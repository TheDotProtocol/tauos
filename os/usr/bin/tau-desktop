#!/bin/bash
# TauOS graphical session — launches the existing TauOS web desktop UI in a kiosk shell
set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export TAUOS_VERSION="${TAUOS_VERSION:-1.0.0}"
PORT="${TAUOS_DESKTOP_PORT:-8765}"

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# Ensure seatd is running (required by cage on many systems)
if command -v systemctl >/dev/null 2>&1; then
  systemctl is-active --quiet seatd 2>/dev/null || systemctl start seatd 2>/dev/null || true
fi

# Start offline-capable desktop API + static file server
if ! curl -sf "http://127.0.0.1:${PORT}/api/system-info" >/dev/null 2>&1; then
  python3 /usr/lib/tauos/desktop-server.py &
  UI_PID=$!
  for _ in $(seq 1 30); do
    curl -sf "http://127.0.0.1:${PORT}/" >/dev/null 2>&1 && break
    sleep 0.2
  done
else
  UI_PID=""
fi

cleanup() {
  [[ -n "${UI_PID:-}" ]] && kill "$UI_PID" 2>/dev/null || true
}
trap cleanup EXIT

URL="http://127.0.0.1:${PORT}/"
CHROMIUM_FLAGS=(
  --no-first-run
  --disable-infobars
  --disable-session-crashed-bubble
  --kiosk
  "$URL"
)

if command -v cage >/dev/null 2>&1 && command -v chromium >/dev/null 2>&1; then
  exec cage -s -- chromium "${CHROMIUM_FLAGS[@]}"
fi

if command -v weston >/dev/null 2>&1 && command -v chromium >/dev/null 2>&1; then
  weston --socket=wayland-0 &
  sleep 1
  exec chromium "${CHROMIUM_FLAGS[@]}"
fi

if command -v chromium >/dev/null 2>&1; then
  exec chromium "${CHROMIUM_FLAGS[@]}"
fi

echo "TauOS desktop UI: open $URL in a browser (chromium/cage not available)" >&2
wait
