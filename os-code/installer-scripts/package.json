{
  "name": "tauos-installer",
  "version": "1.0.0",
  "description": "TauOS - The World's First Privacy-First Operating System",
  "main": "main.js",
  "homepage": "https://www.tauos.org",
  "author": {
    "name": "TauOS Foundation",
    "email": "foundation@tauos.org"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win --x64",
    "build-win-arm64": "electron-builder --win --arm64",
    "build-mac": "electron-builder --mac --x64",
    "build-mac-arm64": "electron-builder --mac --arm64",
    "build-mac-universal": "electron-builder --mac --universal",
    "build-linux": "electron-builder --linux --x64",
    "build-linux-arm64": "electron-builder --linux --arm64",
    "dist": "npm run build-win && npm run build-win-arm64 && npm run build-mac && npm run build-mac-arm64 && npm run build-linux && npm run build-linux-arm64",
    "dist:matrix": "npm run dist"
  },
  "build": {
    "appId": "org.tauos.installer",
    "productName": "TauOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": ["**/*"]
      },
      {
        "from": "../../public/tau-core/legal/",
        "to": "tau-core/legal/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "TauOS Foundation",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "AppImage", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "nodemailer": "^6.9.7",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  }
}
