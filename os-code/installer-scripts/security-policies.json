{
  "version": "1.0.0",
  "policies": {
    "network": {
      "allowInsecureConnections": false,
      "requireTLS": true,
      "allowedDomains": [
        "tauos.org",
        "api.tauos.org"
      ],
      "blockedDomains": [
        "malicious.com",
        "tracker.com"
      ]
    },
    "fileSystem": {
      "sandboxMode": true,
      "allowedPaths": [
        "/apps",
        "/data",
        "/config"
      ],
      "blockedPaths": [
        "/system",
        "/root",
        "/etc"
      ]
    },
    "process": {
      "maxMemoryUsage": "1GB",
      "maxCpuUsage": "80%",
      "processIsolation": true,
      "resourceLimits": true
    },
    "authentication": {
      "requireJWT": true,
      "tokenExpiry": "24h",
      "refreshToken": true,
      "multiFactorAuth": false
    }
  }
}