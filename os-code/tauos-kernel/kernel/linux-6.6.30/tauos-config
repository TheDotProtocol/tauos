# TauCore™ Kernel Configuration
# Privacy-first, zero-telemetry kernel configuration

# Basic kernel configuration
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y

# TauCore™ Privacy Features
CONFIG_PRIVACY_FIRST=y
CONFIG_ZERO_TELEMETRY=y
CONFIG_TAUCORE_SECURITY=y
CONFIG_NO_DATA_COLLECTION=y

# Security enhancements
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y
CONFIG_IMA=y
CONFIG_EVM=y

# Memory protection
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_PAGE_TABLE_ISOLATION=y

# Network security
CONFIG_NETWORK_SECURITY=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP6_NF_SECURITY=y

# File system security
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y

# Hardware support
CONFIG_PCI=y
CONFIG_USB=y
CONFIG_ACPI=y
CONFIG_DMI=y

# Storage support
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CDROM_PKTCDVD=y

# Network support
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_WIRELESS=y

# Graphics support
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_NOUVEAU=y

# Audio support
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y

# TauCore™ specific modules
CONFIG_TAUCORE_DESKTOP=y
CONFIG_TAUCORE_PACKAGE_MANAGER=y
CONFIG_TAUCORE_SERVICE_MANAGER=y
