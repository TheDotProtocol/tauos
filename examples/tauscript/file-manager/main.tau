// File manager — TauScript v1.0
import { write, read, exists, list } from "std.fs";

write("/docs/readme.md", "# Tau Project");
write("/src/main.tau", 'print("app");');

print(exists("/docs/readme.md"));
print(read("/docs/readme.md"));
print(list("/"));

fn test_fs() {
  write("/test.txt", "data");
  print(read("/test.txt"));
}
