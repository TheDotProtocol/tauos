// REST API example — TauScript v1.0
import { stringify, parse } from "std.json";
import { status_ok } from "std.http";

struct ApiResponse {
  status: 200,
  message: ""
}

fn handle_request(path) {
  if (path == "/health") {
    return ApiResponse { status: 200, message: "ok" };
  }
  return ApiResponse { status: 404, message: "not found" };
}

let resp = handle_request("/health");
print(stringify(resp));
print(status_ok(resp.status));

fn test_health() {
  let r = handle_request("/health");
  print(r.message);
}
