{
  "title": "TAU CORE Platform Health",
  "uid": "tauos-platform",
  "timezone": "browser",
  "panels": [
    {
      "title": "Platform status probe",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "probe_success{job=\"tauos-platform-status\"}", "legendFormat": "ok" }]
    },
    {
      "title": "Probe duration (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [{ "expr": "probe_duration_seconds{job=\"tauos-platform-status\"} * 1000", "legendFormat": "latency" }]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
