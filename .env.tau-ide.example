# TauScript / TauScript — required environment variables
# Copy to .env.local and fill in values

# Required for cloud sync, auth, and persistence
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for JWT signing (Tau ID login)
JWT_SECRET=your-secret-minimum-32-characters-long

# Required in PRODUCTION for encrypted project secrets
TAU_IDE_SECRETS_KEY=

# AI providers (at least one recommended for Tau Architect)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# Optional
JWT_SECRET_SSO=
JWT_SECRET_TAUID=
TAU_AI_PROVIDER=
REDIS_URL=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
