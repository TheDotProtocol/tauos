{
  "name": "TauTalkMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "icon": "bash scripts/generate-launcher-icon.sh",
    "android:release": "cd android && ./gradlew assembleRelease",
    "apk:publish": "npm run android:release && cp android/app/build/outputs/apk/release/app-release.apk ../public/downloads/TauTalk-1.0.0-beta.apk && echo 'Published to public/downloads/TauTalk-1.0.0-beta.apk'",
    "test": "jest"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-community/geolocation": "^3.4.0",
    "fast-text-encoding": "^1.0.6",
    "react": "18.2.0",
    "react-native": "0.72.17",
    "react-native-audio-recorder-player": "^3.6.14",
    "react-native-document-picker": "^9.1.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-image-picker": "^5.6.1",
    "react-native-sound-player": "^0.14.5",
    "react-native-vector-icons": "^10.2.0",
    "react-native-view-shot": "^3.8.0",
    "react-native-webrtc": "^111.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.12",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "^0.76.9",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  }
}
